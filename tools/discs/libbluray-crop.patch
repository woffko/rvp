RVP's change to libbluray 1.5.1 for its Windows build: tools/discs/build.sh
applies it after the checkout and stops when it does not apply.

A composition object's crop comes from the stream unchecked: libbluray
passed a crop reaching past its object on to the program as the
overlay's size, and its crop read the object's runs past their end. Here
the crop is clamped to its object (and dropped when it starts outside
it), the crop reads no more runs than the object's width times height
pixels (all an object holds: pg_decode.c refuses any other), and a run
that ends where the crop starts no longer leaves a run of 0, an end of
line, inside a line.

--- a/src/libbluray/decoders/graphics_controller.c
+++ b/src/libbluray/decoders/graphics_controller.c
@@ -617,17 +617,30 @@
         ov.img     = object->img;
 
         if (cobj->crop_flag) {
-            if (cobj->crop_x || cobj->crop_y || cobj->crop_w != object->width) {
-                cropped_img = rle_crop_object(object->img, object->width,
-                                              cobj->crop_x, cobj->crop_y, cobj->crop_w, cobj->crop_h);
+            /* the crop comes from the stream: keep it inside the object */
+            unsigned crop_x = cobj->crop_x, crop_y = cobj->crop_y;
+            unsigned crop_w = cobj->crop_w, crop_h = cobj->crop_h;
+            if (crop_x >= object->width || crop_y >= object->height) {
+                BD_DEBUG(DBG_DECODE | DBG_CRIT, "Crop outside of PG object\n");
+                return;
+            }
+            if (crop_w > object->width - crop_x) {
+                crop_w = object->width - crop_x;
+            }
+            if (crop_h > object->height - crop_y) {
+                crop_h = object->height - crop_y;
+            }
+            if (object->img && (crop_x || crop_y || crop_w != object->width)) {
+                cropped_img = rle_crop_object(object->img, object->width, object->height,
+                                              crop_x, crop_y, crop_w, crop_h);
                 if (!cropped_img) {
                     BD_DEBUG(DBG_DECODE | DBG_CRIT, "Error cropping PG object\n");
                     return;
                 }
                 ov.img = cropped_img;
             }
-            ov.w  = cobj->crop_w;
-            ov.h  = cobj->crop_h;
+            ov.w  = crop_w;
+            ov.h  = crop_h;
         }
 
         ov.palette_update_flag = palette_update_flag;
